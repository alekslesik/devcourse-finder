# Copy this file to .env to override local Docker Compose defaults.
POSTGRES_DB=devcourse
POSTGRES_USER=devcourse
POSTGRES_PASSWORD=devcourse-local
CATALOG_OPERATOR=local-operator

WEB_PORT=3000
API_PORT=8080

# Public website origin for canonical URLs and sitemap.
SITE_URL=http://localhost:3000

# Optional production AI collector (compose.production.yaml only).
# Enable after supplying a newly generated secret in the server's protected .env.
# COMPOSE_PROFILES=ai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VERIFY_MODEL=gpt-4.1
# Optional automatic backup; OpenAI remains primary. Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VERIFY_MODEL=deepseek-v4-pro
CATALOG_AI_BATCH_SIZE=20
CATALOG_AI_DAILY_REQUEST_LIMIT=40
